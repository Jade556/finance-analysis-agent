# ===== LLM 配置（OpenAI 兼容网关：OpenRouter / DeepSeek / 通义 / 本地 vLLM 均可）=====
# 模型名（示例：deepseek/deepseek-chat、openai/gpt-4o、minimax/minimax-m2.1、qwen-plus）
model_name=deepseek/deepseek-chat
# 你的 API Key
openrouter_api_key=sk-or-v1-xxxxxx
# 兼容网关地址（OpenRouter 默认如下；DeepSeek 官方填 https://api.deepseek.com）
OPENAI_API_BASE=https://openrouter.ai/api/v1
